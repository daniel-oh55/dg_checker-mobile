{
  "name": "worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types",
    "typecheck": "pnpm run types && tsc --noEmit",
    "test": "pnpm run types && vitest run",
    "test:converter": "node --test test/converter/authorized-dataset-convert.test.mjs",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "check": "pnpm run typecheck && pnpm run migrate:local && pnpm run test && pnpm run test:converter",
    "dataset:convert": "node scripts/authorized-dataset-convert.mjs",
    "dataset:validate": "node scripts/dataset-import.mjs validate",
    "dataset:build": "node scripts/dataset-import.mjs build-sql"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.2",
    "exceljs": "^4.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
